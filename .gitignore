data/raw/_downloads/
models/
*.pt
*.pth
*.ckpt
*.onnx
*.engine
.claude/settings.local.json

# Imagenette for the EfficientAD penalty loss (auto-downloaded, about 1.5 GB)
data/raw/imagenette/
data/raw/imagenette.partial/

# local working notes, kept on disk but not published
/PLAN.md
/CLAUDE.md
